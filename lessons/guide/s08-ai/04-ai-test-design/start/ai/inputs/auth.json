{
 "$comment": "components.securitySchemes and the POST /api/v1/students security list from Campus Lab's openapi.json, unchanged.",
 "securitySchemes": {
  "ApiKey": {
   "type": "apiKey",
   "in": "header",
   "name": "X-API-Key",
   "description": "From `POST /api/keys`."
  },
  "Basic": {
   "type": "http",
   "scheme": "basic",
   "description": "Your key's basicAuth username/password."
  },
  "Bearer": {
   "type": "http",
   "scheme": "bearer",
   "bearerFormat": "JWT",
   "description": "A token from /oauth/token or /api/v1/auth/student-token."
  },
  "OAuth2": {
   "type": "oauth2",
   "description": "Use the oauthClient that came with your key.",
   "flows": {
    "clientCredentials": {
     "tokenUrl": "/oauth/token",
     "scopes": {
      "students:read": "Read students and everything else",
      "students:write": "Create/update/delete records",
      "enrollments:write": "Enrol and drop",
      "payments:write": "Pay invoices"
     }
    },
    "authorizationCode": {
     "authorizationUrl": "/oauth/authorize",
     "tokenUrl": "/oauth/token",
     "scopes": {
      "students:read": "Read students and everything else",
      "students:write": "Create/update/delete records",
      "enrollments:write": "Enrol and drop",
      "payments:write": "Pay invoices"
     }
    }
   }
  }
 },
 "postStudentsSecurity": [
  {
   "ApiKey": []
  },
  {
   "Basic": []
  },
  {
   "Bearer": []
  },
  {
   "OAuth2": [
    "students:read",
    "students:write",
    "enrollments:write",
    "payments:write"
   ]
  }
 ],
 "postStudentsResponses": [
  "201",
  "401",
  "403",
  "409",
  "422",
  "429",
  "503"
 ]
}