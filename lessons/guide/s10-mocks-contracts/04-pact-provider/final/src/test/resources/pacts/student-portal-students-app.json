      "pending": false,
      "providerStates": [
        {
          "name": "no student has the email pact.ada@example.com"
        }
      ],
      "request": {
        "body": {
          "content": {
            "courses": [
              "Java"
            ],
            "email": "pact.ada@example.com",
            "firstName": "Ada",
            "lastName": "Lovelace",
            "programme": "Computer Science"
          },
          "contentType": "application/json",
