{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "GET /student/list: an array of students",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "firstName",
      "lastName",
      "email",
      "programme",
      "courses"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "pattern": "^[^@\\s]+@[^@\\s]+$"
      },
      "programme": {
        "type": "string"
      },
      "courses": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
