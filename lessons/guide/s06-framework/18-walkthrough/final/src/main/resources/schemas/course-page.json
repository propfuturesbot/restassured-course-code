{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "GET /api/v1/courses: one page of courses",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "credits",
          "capacity",
          "enrolled",
          "seatsAvailable",
          "prerequisites",
          "term"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z]+[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "credits": {
            "type": "integer",
            "minimum": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "enrolled": {
            "type": "integer",
            "minimum": 0
          },
          "seatsAvailable": {
            "type": "integer",
            "minimum": 0
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "term": {
            "type": "string"
          }
        }
      }
    }
  }
}
