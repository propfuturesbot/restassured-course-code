<?xml version="1.0" encoding="UTF-8"?>
<!-- Lesson project: Java 21, REST Assured 6.3.0, TestNG 7.12. Run every test:  mvn test
     One class:  mvn test -Dtest=StudentCrudTest      Targets: see the README of the repository (env vars) -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.coursesmith.restassured</groupId>
  <artifactId>campus-api-tests</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rest-assured.version>6.3.0</rest-assured.version>
    <testng.version>7.12.0</testng.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- REST Assured 6 ships no JSON mapper: without one, body(map or object) fails with
           "Cannot serialize object because no JSON serializer found in classpath" -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.23.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the TestNG listener writes one result file per test into target/allure-results -->
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <version>2.35.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- a REST Assured filter that attaches every request and response to its test in the report -->
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-rest-assured</artifactId>
      <version>2.35.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- 3.5.6, not 3.6.1: surefire 3.6 runs TestNG through the JUnit Platform (testng-engine), and that
             engine's discovery pass reports every test once more as "passed" to the Allure listener.
             3.5.6 still runs TestNG with its own provider: one Allure result per test. -->
        <version>3.5.6</version>
      </plugin>
      <plugin>
        <!-- mvn allure:report turns target/allure-results into an HTML site -->
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>3.1.0</version>
      </plugin>
    </plugins>
  </build>
</project>
